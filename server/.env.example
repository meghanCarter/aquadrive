PORT=4000
DB_PATH=./data/aquadrive.sqlite
PUBLIC_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:4000
TRUST_PROXY_HOPS=0
CURRENCY=USD
# Gateway secrets belong only on the server. Omit to disable EcoCash.
# PAYNOW_INTEGRATION_ID=
# PAYNOW_INTEGRATION_KEY=
# PAYNOW_CURRENCY=USD
# Use for one-time administrator creation, then remove:
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
# ADMIN_PHONE=

# Durable external SQLite on Turso free tier. Server-only; never use EXPO_PUBLIC_.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
# REQUIRE_DURABLE_STORAGE=true

# Activate only after payment/refund/supplier settlement verification.
WALLET_FUNDING_ENABLED=false
